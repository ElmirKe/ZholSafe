<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>kz.zholsafe</groupId>
    <artifactId>zholnet-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ZholNet Server</name>
    <description>ZholSafe distributed hazard-sharing server (Java 21, Spring Boot)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- REST ingestion / queries -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Stage 5 will add:
            spring-boot-starter-validation   (request validation)
            spring-boot-starter-websocket    (server -> vehicle notifications)
            spring-boot-starter-data-jpa + org.postgresql:postgresql + hibernate-spatial (PostGIS)
            spring-boot-starter-actuator     (health/metrics)
          They are intentionally NOT added in Stage 0 to keep the skeleton minimal and buildable.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera: road-facing (rear) analysis in Stage 1; driver-facing is a later stage. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Location: GPS hazard events (Stage 6). Local warnings do NOT depend on it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Network: ZholNet only. Local warnings do NOT depend on it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FOREGROUND_SERVICE / FOREGROUND_SERVICE_CAMERA are intentionally NOT declared: no
         foreground service exists yet. The Stage 1 pipeline runs only while MainActivity is
         started (onStart..onStop). Declare them together with the actual service (deferred 1.x). -->

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".app.ZholSafeApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZholSafe">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

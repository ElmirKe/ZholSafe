<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZholSafe" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/zs_bg</item>
        <item name="colorAccent">@color/zs_accent</item>
    </style>

    <style name="ZsButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/zs_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>

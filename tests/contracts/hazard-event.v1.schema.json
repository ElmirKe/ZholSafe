{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zholsafe.kz/contracts/hazard-event.v1.schema.json",
  "title": "ZholSafe HazardEvent v1",
  "description": "Compact hazard report sent Vehicle -> ZholNet Server over HTTPS REST. No video. All client fields are untrusted input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "vehicleId", "hazardType", "confidence", "risk", "latitude", "longitude", "timestamp"],
  "properties": {
    "eventId":    { "type": "string", "minLength": 1, "description": "Client-generated UUID; server de-duplicates on it." },
    "vehicleId":  { "type": "string", "minLength": 1, "description": "Self-declared; not trusted." },
    "hazardType": { "type": "string", "enum": ["PERSON", "DOG", "HORSE", "COW", "SHEEP", "GOAT", "CAMEL", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk":       { "type": "number", "minimum": 0, "maximum": 1 },
    "latitude":   { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude":  { "type": "number", "minimum": -180, "maximum": 180 },
    "timestamp":  { "type": "string", "format": "date-time" },
    "status":     { "type": "string", "enum": ["ACTIVE", "EXPIRED", "CONFIRMED", "DISMISSED"], "default": "ACTIVE" },
    "evidenceReference": { "type": ["string", "null"], "description": "Reserved for optional future evidence snapshots. Not used in MVP." }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zholsafe.kz/contracts/hazard-event.v1.schema.json",
  "title": "ZholSafe HazardEvent v1",
  "description": "Compact hazard report sent Vehicle -> ZholNet Server over HTTPS REST. No video. All client fields are untrusted input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "vehicleId", "hazardType", "confidence", "risk", "latitude", "longitude", "timestamp"],
  "properties": {
    "eventId":    { "type": "string", "minLength": 1, "description": "Client-generated UUID; server de-duplicates on it." },
    "vehicleId":  { "type": "string", "minLength": 1, "description": "Legacy name for an anonymous, preferably rotating source token; untrusted." },
    "hazardType": { "type": "string", "enum": ["PERSON", "DOG", "HORSE", "COW", "SHEEP", "GOAT", "CAMEL", "STOPPED_VEHICLE", "OBSTACLE", "OTHER", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk":       { "type": "number", "minimum": 0, "maximum": 1 },
    "latitude":   { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude":  { "type": "number", "minimum": -180, "maximum": 180 },
    "timestamp":  { "type": "string", "format": "date-time" },
    "status":     { "type": "string", "enum": ["ACTIVE", "EXPIRED", "CONFIRMED", "DISMISSED"], "default": "ACTIVE" },
    "schemaVersion": { "type": "integer", "enum": [1], "default": 1 },
    "severity": { "type": "string", "enum": ["NORMAL", "CAUTION", "WARNING", "CRITICAL"] },
    "headingDegrees": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
    "approximateDistanceMeters": { "type": "number", "exclusiveMinimum": 0 },
    "ttcSeconds": { "type": "number", "minimum": 0 },
    "evidenceReference": { "type": "null", "description": "Legacy reserved field. Stage 5 rejects non-null evidence references and accepts no media." }
  }
}
